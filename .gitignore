node_modules/
.env
.DS_Store

# Debugging/tuning recordings (ADR-0004): local-only, per-session transcript + summary logs used to
# replay a real meeting against prompt changes. Never published -- this is a record of what was said
# at a church service (names, illness, funerals, prayer requests). The directory is created and
# written to only by server/session-recorder.js, and this line must exist before that code can run.
recordings/

# Everything under .claude/ is local by default: agent identities, the OD decision log, and the hooks
# that enforce our own working discipline. Default-deny on purpose — twice in one day a rule that
# listed what to hide missed something new (gate records in .agent/, then the decision log), and a
# list of exceptions is the wrong shape when the cost of missing one is publishing role names.
# launch.json is the deliberate exception: dev-server configs are useful to anyone who clones this.
# The decision log is unversioned as a result, so it is backed up outside the repo (OD-0013).
.claude/*
!.claude/launch.json

# Session memory — local only, never published (OD-0017: Memory/ and .remember/ retired 2026-07-29)
.memory/

# Orchestration mandate — local only
AGENTS.md

# Everything the agents produce — reports, gate records, local rules, and the code map with its
# changelog queue. All of it is working material for how the repo gets built, not part of the app, so
# the whole folder stays local rather than us maintaining a list of which parts are published.
.agent/
