node_modules/
.env
.DS_Store

# Debugging/tuning recordings (ADR-0004): local-only, per-session transcript + summary logs used to
# replay a real meeting against prompt changes. Ignored for repo hygiene rather than secrecy -- the
# meeting is public and already streamed, so this is not sensitive data (ADR-0004 "Sensitivity and
# retention"); committing these would just bloat the repo and make every diff noisy. The directory is
# created and written to only by server/session-recorder.js, and this line must exist before that
# code can run.
recordings/

# Reader profiles (issue #44): named reading-pace results written to local disk instead of
# localStorage. Ignored because this is one real person's measured reading speed, not test fixture
# data -- the directory is created and written to only by server/reading-pace-store.js, and this
# line must exist before that code can run.
reader-profiles/

# Everything under .claude/ is local by default: agent identities, the OD decision log, and the hooks
# that enforce our own working discipline. Default-deny on purpose — twice in one day a rule that
# listed what to hide missed something new (gate records in .agent/, then the decision log), and a
# list of exceptions is the wrong shape when the cost of missing one is publishing role names.
# launch.json is the deliberate exception: dev-server configs are useful to anyone who clones this.
# The decision log is unversioned as a result, so it is backed up outside the repo (OD-0013).
.claude/*
!.claude/launch.json

# Session memory — local only, never published (OD-0017: Memory/ and .remember/ retired 2026-07-29)
.memory/

# Orchestration mandate — local only
AGENTS.md

# Everything the agents produce — reports, gate records, local rules, and the code map with its
# changelog queue. All of it is working material for how the repo gets built, not part of the app, so
# the whole folder stays local rather than us maintaining a list of which parts are published.
.agent/

# battering-run.js output (Steve, 2026-08-10): timestamped markdown reports pairing real meeting
# text with the summarizer's output, for Steve to read and judge directly rather than take a verbal
# report on. Same rationale as recordings/ (ADR-0004) -- meeting content is not sensitive, this is
# local working material, not part of the app, and disposable once read.
test-reports/
